<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="UTF-8">
  <title>AI PPT Generator</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; overflow: hidden; background: #fff; }
    .frame-container {
      width: 100%;
      height: 100vh;
      overflow: hidden;
      position: relative;
    }
    iframe {
      width: 100%;
      height: 100vh;
      border: none;
      position: absolute;
      top: -110px;   /* 隐藏顶部 Logo 和按钮 */
      left: 0;
    }
  </style>
</head>
<body>
  <div class="frame-container">
    <iframe src="http://192.255.128.40:5001/" 
            allow="fullscreen; clipboard-read; clipboard-write"></iframe>
  </div>
</body>
</html>
