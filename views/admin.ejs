<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin - ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
  <nav class="bg-white shadow p-4 flex justify-between">
    <h1 class="text-xl font-bold">ToolNest Admin</h1>
    <a href="/" class="text-gray-600">Home</a>
  </nav>

  <div class="max-w-5xl mx-auto mt-8 space-y-8">
    <!-- Add Tool -->
    <div class="bg-white rounded shadow p-6">
      <h2 class="text-xl font-bold mb-4">Add Tool</h2>
      <form action="/admin/add-tool" method="POST" class="grid md:grid-cols-2 gap-4">
        <input type="text" name="name" required placeholder="Name" class="border rounded p-2">
        <input type="text" name="icon" placeholder="Icon (emoji)" class="border rounded p-2" value="🔧">
        <input type="text" name="url" required placeholder="URL (e.g. /pdf-tool)" class="border rounded p-2">
        <select name="category" class="border rounded p-2">
          <% categories.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.name %></option>
          <% }); %>
        </select>
        <textarea name="description" placeholder="Description" class="border rounded p-2 md:col-span-2" rows="2"></textarea>
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded md:col-span-2">Add Tool</button>
      </form>
    </div>

    <!-- Tools List -->
    <div class="bg-white rounded shadow p-6">
      <h2 class="text-xl font-bold mb-4">Tools (<%= tools.length %>)</h2>
      <table class="w-full text-sm">
        <thead><tr class="border-b"><th class="text-left py-2">Name</th><th>Category</th><th>Usage</th><th>Action</th></tr></thead>
        <tbody>
          <% tools.forEach(t => { %>
            <tr class="border-b">
              <td class="py-2"><%= t.icon %> <%= t.name %></td>
              <td class="text-center"><%= t.category %></td>
              <td class="text-center"><%= t.usage_count %></td>
              <td class="text-center">
                <form action="/admin/delete/<%= t.id %>" method="POST" class="inline">
                  <button class="text-red-600" onclick="return confirm('Delete?')">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Tool Requests -->
    <div class="bg-white rounded shadow p-6">
      <h2 class="text-xl font-bold mb-4">Tool Requests</h2>
      <% requests.forEach(r => { %>
        <div class="border-b py-3">
          <p class="text-sm text-gray-500"><%= r.email %> · <%= r.status %></p>
          <p class="my-1"><%= r.request %></p>
          <% if (r.status === 'pending') { %>
            <form action="/admin/reply/<%= r.id %>" method="POST" class="mt-2 flex gap-2">
              <input type="text" name="reply" placeholder="Reply message" class="flex-1 border rounded p-1 text-sm">
              <button class="bg-blue-600 text-white px-3 py-1 rounded text-sm">Send</button>
            </form>
          <% } else if (r.reply) { %>
            <p class="text-sm text-green-600">Replied: <%= r.reply %></p>
          <% } %>
        </div>
      <% }); %>
    </div>

    <!-- Announcement -->
    <div class="bg-white rounded shadow p-6">
      <h2 class="text-xl font-bold mb-4">Send Announcement</h2>
      <form action="/admin/announce" method="POST" class="space-y-3">
        <input type="text" name="subject" required placeholder="Subject" class="w-full border rounded p-2">
        <textarea name="message" required placeholder="Message" class="w-full border rounded p-2" rows="3"></textarea>
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded">Send to Active Subscribers</button>
      </form>
    </div>
  </div>
</body>
</html>
