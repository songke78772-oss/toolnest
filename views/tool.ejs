<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= tool.name %> - ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <a href="/" class="text-blue-600 hover:underline">← Back to tools</a>
    
    <div class="bg-white rounded-xl shadow p-8 mt-6">
      <div class="text-5xl mb-4"><%= tool.icon || '🔧' %></div>
      <h1 class="text-3xl font-bold mb-2"><%= tool.name %></h1>
      <p class="text-gray-600 mb-6"><%= tool.description || 'No description' %></p>
      
      <div class="text-sm text-gray-500 mb-6">
        Category: <%= tool.category || 'Uncategorized' %> · 
        Used <%= tool.usage_count || 0 %> times
      </div>

      <% if (tool.url) { %>
        <a href="<%= tool.url %>" target="_blank" class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700">
          Open Tool
        </a>
      <% } else { %>
        <p class="text-gray-500">This tool is not available yet.</p>
      <% } %>
    </div>
  </div>
</body>
</html>
