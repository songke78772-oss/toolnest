<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="UTF-8">
  <title>AI PPT Generator</title>
  <style>
    body, html {
      margin: 0;
      padding: 0;
      height: 100%;
      overflow: hidden;
      background: #ffffff;
    }
    .wrapper {
      position: relative;
      width: 100%;
      height: 100vh;
      overflow: hidden;
    }
    iframe {
      width: 100%;
      height: calc(100% + 120px);
      border: none;
      margin-top: -120px; /* 加大偏移，把顶部完全挤出去 */
      display: block;
    }
    .mask-top {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 120px;
      background: #ffffff;
      z-index: 999;
      pointer-events: none;
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="mask-top"></div>
    <iframe src="http://192.255.128.40/ppt/" 
            allow="fullscreen; clipboard-read; clipboard-write"></iframe>
  </div>
</body>
</html>
