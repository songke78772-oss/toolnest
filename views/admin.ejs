<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin - ToolNest</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <div class="max-w-6xl mx-auto p-6">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold">Admin Dashboard</h1>
      <a href="/admin/logout" class="text-red-600">Logout</a>
    </div>

    <!-- Add Tool Form -->
    <div class="bg-white p-6 rounded-lg shadow mb-6">
      <h2 class="text-lg font-semibold mb-4">Add Tool</h2>
      <form action="/admin/add-tool" method="POST" class="grid grid-cols-2 gap-4">
        <input type="text" name="name" placeholder="Name" required class="border rounded px-3 py-2">
        <input type="text" name="icon" placeholder="Icon (emoji)" class="border rounded px-3 py-2">
        <input type="text" name="url" placeholder="URL" required class="border rounded px-3 py-2">
        <select name="category" class="border rounded px-3 py-2">
          <option value="Office">Office</option>
          <option value="Development">Development</option>
          <option value="Life">Life</option>
          <option value="Entertainment">Entertainment</option>
        </select>
        <textarea name="description" placeholder="Description" class="border rounded px-3 py-2 col-span-2"></textarea>
        <button type="submit" class="bg-blue-600 text-white py-2 rounded col-span-2">Add Tool</button>
      </form>
    </div>

    <!-- Tools List -->
    <div class="bg-white p-6 rounded-lg shadow mb-6">
      <h2 class="text-lg font-semibold mb-4">Tools</h2>
      <table class="w-full border">
        <thead class="bg-gray-100">
          <tr>
            <th class="border p-2 text-left">Name</th>
            <th class="border p-2 text-left">Category</th>
            <th class="border p-2 text-left">URL</th>
            <th class="border p-2">Action</th>
          </tr>
        </thead>
        <tbody>
          <% tools.forEach(tool => { %>
            <tr>
              <td class="border p-2"><%= tool.icon %> <%= tool.name %></td>
              <td class="border p-2"><%= tool.category %></td>
              <td class="border p-2 text-sm"><%= tool.url %></td>
              <td class="border p-2 text-center">
                <form action="/admin/delete/<%= tool.id %>" method="POST" class="inline">
                  <button type="submit" class="text-red-600" onclick="return confirm('Delete this tool?')">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Users List -->
    <div class="bg-white p-6 rounded-lg shadow">
      <h2 class="text-lg font-semibold mb-4">Registered Users</h2>
      <table class="w-full border">
        <thead class="bg-gray-100">
          <tr>
            <th class="border p-2 text-left">ID</th>
            <th class="border p-2 text-left">Email</th>
            <th class="border p-2 text-left">Verified</th>
            <th class="border p-2 text-left">Created</th>
            <th class="border p-2">Action</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(user => { %>
            <tr>
              <td class="border p-2"><%= user.id %></td>
              <td class="border p-2"><%= user.email %></td>
              <td class="border p-2"><%= user.verified ? 'Yes' : 'No' %></td>
              <td class="border p-2 text-sm"><%= user.created_at %></td>
              <td class="border p-2 text-center">
                <form action="/admin/delete-user/<%= user.id %>" method="POST" class="inline">
                  <button type="submit" class="text-red-600" onclick="return confirm('Delete this user?')">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
